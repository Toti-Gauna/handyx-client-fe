# Todo NEXT_PUBLIC_* es PÚBLICO (queda en el JS del celular): nunca secretos.
# local | preview | produccion. Producción exige API real por HTTPS (el build falla sin ella).
NEXT_PUBLIC_ENTORNO=local
# Origen de handyx-client-be. Vacío = vista de prueba con datos ficticios (adaptador mock).
NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_MAPA_DATOS no va acá: lo fija el build según si existe public/mapa/mdp.pmtiles (npm run mdp:datos).
