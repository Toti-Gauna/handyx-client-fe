{
  "name": "handyx-client-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "predev": "node scripts/mapa-worker.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5175",
    "prebuild": "node scripts/mapa-worker.mjs",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "contracts:sync": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "mapa": "node --experimental-strip-types scripts/mapa.ts",
    "mapa:check": "node --experimental-strip-types scripts/mapa.ts --check",
    "mdp:datos": "sh scripts/mapa-datos.sh",
    "mdp:verificar": "node scripts/mapa-verificar.mjs",
    "e2e": "node tests/e2e/recorrido.cjs capturas-e2e && node tests/e2e/escenarios.cjs capturas-e2e && node tests/e2e/accesibilidad.cjs capturas-e2e && node tests/e2e/teclado.cjs && node tests/e2e/pwa.cjs capturas-e2e && node tests/e2e/handia.cjs capturas-e2e && node tests/e2e/mapa.cjs capturas-e2e",
    "capturas": "node tests/e2e/escenarios.cjs docs/screens/capturas/escenarios && node tests/e2e/capturas.cjs docs/screens/capturas",
    "kit": "node scripts/kit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "geojson-vt": "5.0.4",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vt-pbf": "3.1.3"
  }
}
